# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=
# Optional (paid): Anthropic API key for Claude analysis. Leave empty for the free keyword analyzer.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for sentiment/quote analysis
# CLAUDE_MODEL=claude-opus-5-5
# APP_PASSWORD=
# Optional (free): Naver Search API keys for better Korean news in the report
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
